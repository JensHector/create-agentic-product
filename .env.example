# Pitch Coach Pro — copy this file to ".env" in the project root and fill in your key.
# The .env file is gitignored. Only the backend (server/) reads it; the browser never sees it.

# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which model the executive personas + feedback run on.
# Default is Claude Sonnet 4.6 — fast, current, best speed/intelligence balance
# for real-time spoken pitches. For the hardest reasoning you could try an Opus
# (e.g. MODEL=claude-opus-4-8), at higher latency and cost.
MODEL=claude-sonnet-4-6

# Optional: backend port (must match the proxy target in web/vite.config.js)
PORT=8787
